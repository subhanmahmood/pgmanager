# Caddy fronts pgmanager with automatic HTTPS via Let's Encrypt.
# `pgmanager` listens on :8080 inside the docker network only.
#
# One hostname, PGMANAGER_API_DOMAIN, serves both the JSON API and the browser
# admin UI from the same process — so the UI calls /api same-origin, no CORS
# config is needed, and there is only one certificate and one DNS record to
# keep alive.

{$PGMANAGER_API_DOMAIN} {
    encode zstd gzip

    reverse_proxy pgmanager:8080 {
        # Preserve the original Host header so pgmanager can derive the
        # client-reachable hostname for connection strings. Without this,
        # Caddy rewrites Host to "pgmanager:8080" (the upstream address)
        # and `db create` responses fall back to POSTGRES_HOST.
        header_up Host              {host}
        header_up X-Forwarded-Proto {scheme}
        header_up X-Forwarded-For   {remote_host}
    }
}
