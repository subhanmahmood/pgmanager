# Copy to .env and fill in.

# Public hostname Caddy should serve. Must have a DNS A/AAAA record pointing
# at this VPS. Let's Encrypt will issue a cert for it automatically.
# This one hostname serves both the API and the browser admin UI.
PGMANAGER_API_DOMAIN=pgm.example.com

# Postgres password (used both for the postgres service and for pgmanager's
# connection string). Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# At-rest encryption key for database passwords stored in pgmanager metadata.
# Generate with: pgmanager keygen
# (or: openssl rand -base64 32)
PGMANAGER_ENCRYPTION_KEY=

# Optional. If set, pgmanager registers this as the initial admin token
# instead of auto-generating one. Useful for declarative deploys.
# PGMANAGER_BOOTSTRAP_TOKEN=pgm_live_xxxxxxxxxxxxxxxxxxxx

# Optional. By default, connection strings returned by `db create` use
# PGMANAGER_API_DOMAIN as the host. Override only if Postgres lives on a
# different DNS name than the API.
# POSTGRES_PUBLIC_HOST=db.example.com
# POSTGRES_PUBLIC_PORT=5432

# Optional. Per-database backups to S3-compatible object storage
# (dev/staging/prod only, never pr). Leave unset to keep backups disabled.
# Requires uncommenting the matching PGMANAGER_BACKUP_* block in
# docker-compose.yml.
# PGMANAGER_BACKUP_ENDPOINT=            # empty = AWS S3; set for R2/B2/MinIO
# PGMANAGER_BACKUP_REGION=
# PGMANAGER_BACKUP_BUCKET=
# PGMANAGER_BACKUP_PREFIX=
# PGMANAGER_BACKUP_ACCESS_KEY_ID=
# PGMANAGER_BACKUP_SECRET_ACCESS_KEY=
